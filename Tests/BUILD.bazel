load("@rules_apple//apple:ios.bzl", "ios_unit_test")
load("@rules_apple//apple:macos.bzl", "macos_unit_test")
load("@rules_apple//apple:tvos.bzl", "tvos_unit_test")
load("@rules_apple//apple:watchos.bzl", "watchos_unit_test")
load("@rules_shell//shell:sh_test.bzl", "sh_test")
load("@rules_swift//swift:swift_library.bzl", "swift_library")
load(":xctest_runner.bzl", "macos_xctest_runner")
load(":xctest_runner_info_test.bzl", "xctest_runner_info_test")

# From this folder: `bazel test //...` (Tests/.bazelrc adds --test_tag_filters=-tvos,-watchos) runs the tests on macOS and
# on an iOS simulator, and can build them for tvOS and watchOS. rules_apple's default tvOS and watchOS
# runners fail every test without running it, so no run tests those bundles.

macos_xctest_runner(name = "macos_xctest_runner")

# Checks the runner's script with a stand-in for xctest.
sh_test(
    name = "xctest_runner_test",
    srcs = ["xctest_runner_test.sh"],
    args = ["$(rootpath :xctest_runner.template.sh)"],
    data = [":xctest_runner.template.sh"],
)

# Checks the runner passes on the Xcode that Bazel selected.
xctest_runner_info_test(
    name = "xctest_runner_info_test",
    runner = ":macos_xctest_runner",
)

swift_library(
    name = "CucumberSwiftExpressionsTestsLib",
    testonly = True,
    srcs = glob(["CucumberSwiftExpressionsTests/**/*.swift"]),
    module_name = "CucumberSwiftExpressionsTests",
    deps = ["@cucumberswift_expressions//:CucumberSwiftExpressions"],
)

# The minimum OS versions are the lowest that CucumberSwift supports, so the library is
# compiled for them too, and an API that is too new fails here rather than for a consumer.
# Xcode's XCTest is built for newer versions, so the linker warns about it; that is expected.
# macOS runs the bundle with `xcrun xctest` (see xctest_runner.bzl). iOS keeps
# rules_apple's runner, which runs the tests on a simulator.
macos_unit_test(
    name = "CucumberSwiftExpressionsTests",
    minimum_os_version = "10.15",
    runner = ":macos_xctest_runner",
    deps = [":CucumberSwiftExpressionsTestsLib"],
)

ios_unit_test(
    name = "CucumberSwiftExpressionsTests_iOS",
    minimum_os_version = "13.0",
    deps = [":CucumberSwiftExpressionsTestsLib"],
)

# Built, never run: Tests/.bazelrc leaves them out of every test run, and a pull request's CI
# also leaves them out of the build (--build_tag_filters).
# The tvOS and watchOS tests run through Xcode and SwiftPM.
tvos_unit_test(
    name = "CucumberSwiftExpressionsTests_tvOS",
    minimum_os_version = "13.0",
    tags = ["tvos"],
    deps = [":CucumberSwiftExpressionsTestsLib"],
)

watchos_unit_test(
    name = "CucumberSwiftExpressionsTests_watchOS",
    minimum_os_version = "7.4",
    tags = ["watchos"],
    deps = [":CucumberSwiftExpressionsTestsLib"],
)
