# Runs CucumberSwiftExpressionsTests against cucumberswift_expressions as a
# dependency, the way a Bazel project uses it. Run Bazel from this folder.
module(name = "cucumberswift_expressions_tests")

bazel_dep(name = "apple_support", version = "2.9.1")
bazel_dep(name = "rules_swift", version = "4.1.2")
bazel_dep(name = "rules_apple", version = "5.2.0")
bazel_dep(name = "rules_shell", version = "0.6.1")
bazel_dep(name = "cucumberswift_expressions")
local_path_override(
    module_name = "cucumberswift_expressions",
    path = "..",
)

# rules_swift scans only the macOS and iOS SDKs for system modules unless the root module asks
# for more. The tvOS and watchOS tests need those simulators' SDKs.
system_sdk = use_extension("@rules_swift//swift:extensions.bzl", "system_sdk")
system_sdk.configure_sdks(names = ["AppleTVSimulator", "WatchSimulator"])
